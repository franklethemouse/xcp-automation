@page "/deploy"
@inject IVmDeploymentService DeploymentService
@inject IXcpHostService HostService
@inject IMessageService MessageService
@inject NavigationManager Navigation

<PageHeader Title="Deploy Virtual Machine">
    <PageHeaderExtra>
        <Button OnClick="GoBackToVms">
            <Icon Type="arrow-left" /> Back to VMs
        </Button>
    </PageHeaderExtra>
</PageHeader>

<Card Style="max-width: 1000px; margin: 0 auto;">
    <Title Level="3">Step 1: Select Template</Title>

    <Form Model="@formModel">
        <FormItem Label="XCP-ng Host">
            <RadioGroup @bind-Value="@formModel.HostId">
                @foreach (var host in hosts)
                {
                    <Radio RadioButton Value="@host.HostId">@host.HostName</Radio>
                }
            </RadioGroup>
        </FormItem>

        <FormItem>
            <Button Type="@ButtonType.Primary" OnClick="LoadTemplatesClick" Disabled="@string.IsNullOrEmpty(formModel.HostId)">
                Load Templates
            </Button>
        </FormItem>

        @if (loadingTemplates)
        {
            <FormItem>
                <div style="text-align: center; padding: 40px;">
                    <Spin Size="large" Tip="Loading templates..." />
                </div>
            </FormItem>
        }
        else if (templates.Any())
        {
            <FormItem Label="Template">
                <RadioGroup @bind-Value="@formModel.TemplateUuid">
                    @foreach (var template in templates)
                    {
                        <Radio RadioButton Value="@template.Uuid">@template.NameLabel</Radio>
                    }
                </RadioGroup>
            </FormItem>

            <FormItem>
                <Button Type="@ButtonType.Primary" Disabled="string.IsNullOrEmpty(formModel.TemplateUuid)">
                    Next: Configure <Icon Type="arrow-right" />
                </Button>
            </FormItem>
        }
    </Form>
</Card>

@code {
    private List<Data.XcpHost> hosts = new();
    private List<VmTemplate> templates = new();
    
    private DeployFormModel formModel = new();
    private bool loadingTemplates;

    protected override async Task OnInitializedAsync()
    {
        hosts = await HostService.GetAllHostsAsync();
    }

    private async Task LoadTemplatesClick()
    {
        if (string.IsNullOrEmpty(formModel.HostId)) return;

        loadingTemplates = true;
        StateHasChanged();

        try
        {
            templates = await DeploymentService.GetTemplatesAsync(formModel.HostId);
        }
        catch (Exception ex)
        {
            await MessageService.Error($"Failed to load templates: {ex.Message}");
        }
        finally
        {
            loadingTemplates = false;
        }
    }

    private void GoBackToVms()
    {
        Navigation.NavigateTo("/vms");
    }

    public class DeployFormModel
    {
        public string HostId { get; set; } = string.Empty;
        public string TemplateUuid { get; set; } = string.Empty;
    }
}
