@page "/deploy"
@inject IVmDeploymentService DeploymentService
@inject IXcpHostService HostService
@inject IMessageService MessageService
@inject NavigationManager Navigation

<PageHeader Title="Deploy Virtual Machine">
    <PageHeaderExtra>
        <Button OnClick="GoBackToVms">
            <Icon Type="arrow-left" /> Back to VMs
        </Button>
    </PageHeaderExtra>
</PageHeader>

<Card Style="max-width: 1000px; margin: 0 auto;">
    <Title Level="3">VM Deployment - Coming Soon</Title>
    <Paragraph>
        The VM deployment feature is currently under development.
    </Paragraph>
    <Paragraph>
        This will allow you to:
    </Paragraph>
    <ul>
        <li>Select templates from your XCP-ng host</li>
        <li>Configure CPU, Memory, and Disk resources</li>
        <li>Deploy new VMs automatically</li>
    </ul>
    
    <Button Type="@ButtonType.Primary" OnClick="GoBackToVms">
        Back to Virtual Machines
    </Button>
</Card>

@code {
    private void GoBackToVms()
    {
        Navigation.NavigateTo("/vms");
    }
}
