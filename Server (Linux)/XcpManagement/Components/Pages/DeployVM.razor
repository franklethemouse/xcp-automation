@page "/deploy"
@inject IVmDeploymentService DeploymentService
@inject IXcpHostService HostService
@inject IMessageService MessageService
@inject NavigationManager Navigation

<PageHeader Title="Deploy Virtual Machine">
    <PageHeaderExtra>
        <Button OnClick="GoBackToVms">
            <Icon Type="arrow-left" /> Back to VMs
        </Button>
    </PageHeaderExtra>
</PageHeader>

<Card Style="max-width: 1000px; margin: 0 auto;">
    <Title Level="3">Step 1: Select Template</Title>

    <div style="margin-bottom: 24px;">
        <label style="display: block; margin-bottom: 8px;"><strong>XCP-ng Host:</strong></label>
        <Select TItem="string" 
                TItemValue="string"
                Value="@selectedHostId"
                OnSelectedItemChanged="OnHostSelected"
                Placeholder="Select host"
                Style="width: 400px;">
            @foreach (var host in hosts)
            {
                <SelectOption TItem="string" TItemValue="string" Value="@host.HostId" Label="@host.HostName" />
            }
        </Select>
    </div>

    <Button Type="@ButtonType.Primary" OnClick="LoadTemplatesClick" Disabled="@string.IsNullOrEmpty(selectedHostId)">
        Load Templates
    </Button>

    @if (loadingTemplates)
    {
        <div style="text-align: center; padding: 40px;">
            <Spin Size="large" Tip="Loading templates..." />
        </div>
    }
    else if (templates.Any())
    {
        <Divider />
        
        <div style="margin-bottom: 24px;">
            <label style="display: block; margin-bottom: 8px;"><strong>Template:</strong></label>
            <Select TItem="string" 
                    TItemValue="string"
                    @bind-Value="selectedTemplateUuid" 
                    Placeholder="Select a template"
                    Style="width: 400px;">
                @foreach (var template in templates)
                {
                    <SelectOption TItem="string" TItemValue="string" Value="@template.Uuid" Label="@template.NameLabel" />
                }
            </Select>
        </div>

        <Button Type="@ButtonType.Primary" Disabled="string.IsNullOrEmpty(selectedTemplateUuid)">
            Next: Configure <Icon Type="arrow-right" />
        </Button>
    }
</Card>

@code {
    private List<Data.XcpHost> hosts = new();
    private List<VmTemplate> templates = new();
    
    private string selectedHostId = string.Empty;
    private string selectedTemplateUuid = string.Empty;
    
    private bool loadingTemplates;

    protected override async Task OnInitializedAsync()
    {
        hosts = await HostService.GetAllHostsAsync();
        
        if (hosts.Count == 1)
        {
            selectedHostId = hosts[0].HostId;
        }
    }

    private async Task LoadTemplatesClick()
    {
        if (string.IsNullOrEmpty(selectedHostId)) return;

        loadingTemplates = true;
        StateHasChanged();

        try
        {
            templates = await DeploymentService.GetTemplatesAsync(selectedHostId);
        }
        catch (Exception ex)
        {
            await MessageService.Error($"Failed to load templates: {ex.Message}");
        }
        finally
        {
            loadingTemplates = false;
        }
    }

    private void GoBackToVms()
    {
        Navigation.NavigateTo("/vms");
    }

    private void OnHostSelected(string value)
    {
        selectedHostId = value;
        StateHasChanged();
    }
}
