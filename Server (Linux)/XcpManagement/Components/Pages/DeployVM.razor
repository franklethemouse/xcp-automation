@page "/deploy"
@inject IVmDeploymentService DeploymentService
@inject IXcpHostService HostService
@inject IMessageService MessageService
@inject NavigationManager Navigation

<PageHeader Title="Deploy Virtual Machine">
    <PageHeaderExtra>
        <Button OnClick="GoBackToVms">
            <Icon Type="arrow-left" /> Back to VMs
        </Button>
    </PageHeaderExtra>
</PageHeader>

@if (deploymentInProgress)
{
    <Card Title="Deployment in Progress" Style="max-width: 800px; margin: 0 auto;">
        <div style="margin-top: 32px;">
            <Progress Percent="@progress.PercentComplete" />
            
            <div style="margin-top: 16px; text-align: center;">
                <Title Level="4">@progress.Stage</Title>
                <Paragraph>@progress.Message</Paragraph>
            </div>

            @if (progress.HasError)
            {
                <Alert Type="@AlertType.Error" 
                       Message="Deployment Failed"
                       Description="@progress.ErrorMessage"
                       ShowIcon />
                
                <div style="text-align: center; margin-top: 16px;">
                    <Button Type="@ButtonType.Primary" OnClick="ResetForm">Try Again</Button>
                </div>
            }
            else if (progress.IsComplete)
            {
                <Result Status="success"
                        Title="VM Deployed Successfully!"
                        SubTitle="@($"Virtual machine '{deploymentRequest.VmName}' has been created.")">
                    <Extra>
                        <Space>
                            <SpaceItem>
                                <Button Type="@ButtonType.Primary" OnClick="GoBackToVms">
                                    View All VMs
                                </Button>
                            </SpaceItem>
                            <SpaceItem>
                                <Button OnClick="ResetForm">Deploy Another</Button>
                            </SpaceItem>
                        </Space>
                    </Extra>
                </Result>
            }
        </div>
    </Card>
}
else
{
    <Card Style="max-width: 1000px; margin: 0 auto;">
        
        @* Step 1: Template Selection *@
        @if (currentStep == 0)
        {
            <Title Level="3">Step 1: Select Template</Title>

            <FormItem Label="XCP-ng Host">
                <Select TItem="string" 
                        TItemValue="string"
                        @bind-Value="selectedHostId" 
                        Placeholder="Select host"
                        Style="width: 100%;">
                    @foreach (var host in hosts)
                    {
                        <SelectOption TItem="string" TItemValue="string" Value="@host.HostId" Label="@host.HostName" />
                    }
                </Select>
            </FormItem>

            <Button Type="@ButtonType.Primary" OnClick="LoadTemplatesClick" Disabled="@string.IsNullOrEmpty(selectedHostId)">
                Load Templates
            </Button>

            @if (loadingTemplates)
            {
                <div style="text-align: center; padding: 40px;">
                    <Spin Size="large" Tip="Loading templates..." />
                </div>
            }
            else if (templates.Any())
            {
                <FormItem Label="Template" Style="margin-top: 16px;">
                    <Select TItem="string" 
                            TItemValue="string"
                            @bind-Value="selectedTemplateUuid" 
                            Placeholder="Select a template"
                            Style="width: 100%;">
                        @foreach (var template in templates)
                        {
                            <SelectOption TItem="string" TItemValue="string" Value="@template.Uuid" Label="@template.NameLabel" />
                        }
                    </Select>
                </FormItem>

                @if (selectedTemplate != null)
                {
                    <Alert Type="@AlertType.Info" Style="margin: 16px 0;">
                        <MessageTemplate>
                            <strong>Template Details:</strong><br/>
                            CPUs: @selectedTemplate.VcpusMax | 
                            Memory: @((selectedTemplate.MemoryStaticMax / 1024 / 1024).ToString("N0")) MB
                        </MessageTemplate>
                    </Alert>
                }

                <Button Type="@ButtonType.Primary" 
                        OnClick="NextToConfig"
                        Disabled="string.IsNullOrEmpty(selectedTemplateUuid)">
                    Next: Configure <Icon Type="arrow-right" />
                </Button>
            }
        }

        @* Step 2: Resource Configuration *@
        @if (currentStep == 1)
        {
            <Title Level="3">Step 2: Configure Resources</Title>

            <FormItem Label="VM Name">
                <Input @bind-Value="deploymentRequest.VmName" 
                       Placeholder="e.g., WEB-SERVER-01" 
                       MaxLength="50" />
            </FormItem>

            <Divider>CPU Configuration</Divider>

            <FormItem Label="Number of CPUs">
                <AntDesign.InputNumber @bind-Value="deploymentRequest.CpuCount" 
                                      Min="1" Max="64" />
            </FormItem>

            <FormItem Label="Cores per Socket">
                <AntDesign.InputNumber @bind-Value="deploymentRequest.CoresPerSocket" 
                                      Min="1" Max="16" />
            </FormItem>

            <Alert Type="@AlertType.Info" Style="margin-bottom: 16px;">
                <MessageTemplate>
                    <strong>Total vCPUs:</strong> @(deploymentRequest.CpuCount * deploymentRequest.CoresPerSocket)
                </MessageTemplate>
            </Alert>

            <Divider>Memory Configuration</Divider>

            <FormItem Label="Memory (MB)">
                <AntDesign.InputNumber @bind-Value="deploymentRequest.MemoryMB" 
                                      Min="512" Max="524288" Step="512" />
                <Text Type="secondary"> (@((deploymentRequest.MemoryMB / 1024.0).ToString("F1")) GB)</Text>
            </FormItem>

            <Divider>Storage Configuration</Divider>

            <FormItem Label="Primary Disk Size (GB)">
                <AntDesign.InputNumber @bind-Value="deploymentRequest.DiskSizeGB" 
                                      Min="1" Max="16384" />
            </FormItem>

            <Divider>Network Configuration</Divider>

            @if (networks.Any())
            {
                <FormItem Label="Network">
                    <Select TItem="string" 
                            TItemValue="string"
                            @bind-Value="selectedNetworkUuid" 
                            Placeholder="Select network"
                            Style="width: 100%;">
                        @foreach (var network in networks)
                        {
                            <SelectOption TItem="string" TItemValue="string" Value="@network.Uuid" Label="@network.NameLabel" />
                        }
                    </Select>
                </FormItem>
            }

            <Divider>Start Options</Divider>

            <FormItem Label="Auto-Start">
                <Switch @bind-Checked="deploymentRequest.StartAfterCreation" />
                <Text Type="secondary"> Start VM immediately after creation</Text>
            </FormItem>

            <Space>
                <SpaceItem>
                    <Button OnClick="BackToTemplate">
                        <Icon Type="arrow-left" /> Back
                    </Button>
                </SpaceItem>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" OnClick="NextToReview">
                        Next: Review <Icon Type="arrow-right" />
                    </Button>
                </SpaceItem>
            </Space>
        }

        @* Step 3: Review & Deploy *@
        @if (currentStep == 2)
        {
            <Title Level="3">Step 3: Review & Deploy</Title>

            <Descriptions Title="Deployment Summary" Bordered Column="1">
                <DescriptionsItem Title="VM Name">
                    <strong>@deploymentRequest.VmName</strong>
                </DescriptionsItem>
                <DescriptionsItem Title="Host">
                    @hosts.FirstOrDefault(h => h.HostId == selectedHostId)?.HostName
                </DescriptionsItem>
                <DescriptionsItem Title="Template">
                    @selectedTemplate?.NameLabel
                </DescriptionsItem>
                <DescriptionsItem Title="CPUs">
                    @deploymentRequest.CpuCount × @deploymentRequest.CoresPerSocket cores = 
                    <Tag Color="blue">@(deploymentRequest.CpuCount * deploymentRequest.CoresPerSocket) vCPUs</Tag>
                </DescriptionsItem>
                <DescriptionsItem Title="Memory">
                    <Tag Color="green">@deploymentRequest.MemoryMB MB</Tag>
                </DescriptionsItem>
                <DescriptionsItem Title="Primary Disk">
                    <Tag Color="purple">@deploymentRequest.DiskSizeGB GB</Tag>
                </DescriptionsItem>
                <DescriptionsItem Title="Network">
                    @networks.FirstOrDefault(n => n.Uuid == selectedNetworkUuid)?.NameLabel
                </DescriptionsItem>
                <DescriptionsItem Title="Auto-Start">
                    @if (deploymentRequest.StartAfterCreation)
                    {
                        <Tag Color="success">Yes</Tag>
                    }
                    else
                    {
                        <Tag>No</Tag>
                    }
                </DescriptionsItem>
            </Descriptions>

            <Alert Type="@AlertType.Warning" 
                   Message="Ready to Deploy" 
                   Description="Please review the configuration above."
                   Style="margin: 24px 0;" />

            <Space>
                <SpaceItem>
                    <Button OnClick="BackToConfig">
                        <Icon Type="arrow-left" /> Back
                    </Button>
                </SpaceItem>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" 
                            OnClick="HandleDeploy"
                            Size="large">
                        <Icon Type="rocket" /> Deploy Virtual Machine
                    </Button>
                </SpaceItem>
            </Space>
        }

    </Card>
}

@code {
    private List<Data.XcpHost> hosts = new();
    private List<VmTemplate> templates = new();
    private List<XcpNetwork> networks = new();
    
    private string selectedHostId = string.Empty;
    private string selectedTemplateUuid = string.Empty;
    private string selectedNetworkUuid = string.Empty;
    
    private VmTemplate? selectedTemplate;
    private bool loadingTemplates;
    private bool loadingNetworks;
    
    private int currentStep = 0;
    private bool deploymentInProgress;
    
    private VmDeploymentRequest deploymentRequest = new();
    private DeploymentProgress progress = new();

    protected override async Task OnInitializedAsync()
    {
        hosts = await HostService.GetAllHostsAsync();
        
        if (hosts.Count == 1)
        {
            selectedHostId = hosts[0].HostId;
        }
    }

    private async Task LoadTemplatesClick()
    {
        if (string.IsNullOrEmpty(selectedHostId)) return;

        loadingTemplates = true;
        loadingNetworks = true;
        StateHasChanged();

        try
        {
            templates = await DeploymentService.GetTemplatesAsync(selectedHostId);
            networks = await DeploymentService.GetNetworksAsync(selectedHostId);
        }
        catch (Exception ex)
        {
            await MessageService.Error($"Failed to load templates: {ex.Message}");
        }
        finally
        {
            loadingTemplates = false;
            loadingNetworks = false;
        }
    }

    private void NextToConfig()
    {
        selectedTemplate = templates.FirstOrDefault(t => t.Uuid == selectedTemplateUuid);
        
        if (selectedTemplate != null)
        {
            deploymentRequest.CpuCount = selectedTemplate.VcpusMax > 0 ? selectedTemplate.VcpusMax : 2;
            deploymentRequest.MemoryMB = selectedTemplate.MemoryStaticMax > 0 
                ? (int)(selectedTemplate.MemoryStaticMax / 1024 / 1024) 
                : 2048;
        }
        
        currentStep = 1;
    }

    private void BackToTemplate()
    {
        currentStep = 0;
    }

    private void NextToReview()
    {
        currentStep = 2;
    }

    private void BackToConfig()
    {
        currentStep = 1;
    }

    private void GoBackToVms()
    {
        Navigation.NavigateTo("/vms");
    }

    private async Task HandleDeploy()
    {
        try
        {
            await DeploymentService.ValidateDeploymentRequestAsync(deploymentRequest);

            deploymentRequest.HostId = selectedHostId;
            deploymentRequest.TemplateUuid = selectedTemplateUuid;
            deploymentRequest.TemplateName = selectedTemplate?.NameLabel ?? "";
            deploymentRequest.NetworkUuid = selectedNetworkUuid;
            deploymentRequest.NetworkName = networks.FirstOrDefault(n => n.Uuid == selectedNetworkUuid)?.NameLabel ?? "";

            deploymentInProgress = true;
            currentStep = 2;
            
            var progressReporter = new Progress<DeploymentProgress>(p =>
            {
                progress = p;
                InvokeAsync(StateHasChanged);
            });

            await DeploymentService.DeployVmAsync(deploymentRequest, progressReporter);
        }
        catch (Exception ex)
        {
            await MessageService.Error($"Deployment error: {ex.Message}");
            deploymentInProgress = false;
        }
    }

    private void ResetForm()
    {
        deploymentRequest = new VmDeploymentRequest();
        progress = new DeploymentProgress();
        selectedTemplateUuid = string.Empty;
        selectedNetworkUuid = string.Empty;
        selectedTemplate = null;
        currentStep = 0;
        deploymentInProgress = false;
    }
}
