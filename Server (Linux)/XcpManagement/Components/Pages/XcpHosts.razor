@page "/hosts"
@inject IXcpHostService HostService
@inject IMessageService MessageService

<PageHeader Title="XCP-ng Hosts">
    <PageHeaderExtra>
        <Button Type="@ButtonType.Primary" OnClick="ShowAddModal">
            <Icon Type="plus" /> Add Host
        </Button>
    </PageHeaderExtra>
</PageHeader>

<Table TItem="Data.XcpHost" DataSource="@hosts" Loading="@loading">
    <PropertyColumn Property="c => c.HostName" Title="Host Name" />
    <PropertyColumn Property="c => c.HostUrl" Title="URL" />
    <PropertyColumn Property="c => c.Active" Title="Status">
        <Tag Color="@(context.Active ? "green" : "red")">
            @(context.Active ? "Active" : "Inactive")
        </Tag>
    </PropertyColumn>
    <PropertyColumn Property="c => c.LastConnected" Title="Last Connected">
        @(context.LastConnected?.ToString("yyyy-MM-dd HH:mm") ?? "Never")
    </PropertyColumn>
    <ActionColumn Title="Actions">
        <Space>
            <SpaceItem><Button Size="small" OnClick="() => TestConnection(context)">Test</Button></SpaceItem>
            <SpaceItem><Button Size="small" Danger OnClick="() => DeleteHost(context)">Delete</Button></SpaceItem>
        </Space>
    </ActionColumn>
</Table>

<Modal Title="Add XCP-ng Host"
       @bind-Visible="addModalVisible"
       OnCancel="() => addModalVisible = false"
       Footer="null">
    <div style="padding: 16px;">
        <div style="margin-bottom: 16px;">
            <div style="margin-bottom: 4px;"><strong>Host Name</strong></div>
            <Input @bind-Value="@newHost.HostName" />
        </div>
        <div style="margin-bottom: 16px;">
            <div style="margin-bottom: 4px;"><strong>URL</strong></div>
            <Input @bind-Value="@newHost.HostUrl" Placeholder="https://192.168.1.100" />
            <div style="font-size: 12px; color: #888; margin-top: 4px;">Must start with https:// or http://</div>
        </div>
        <div style="margin-bottom: 16px;">
            <div style="margin-bottom: 4px;"><strong>Username</strong></div>
            <Input @bind-Value="@newHost.Username" />
        </div>
        <div style="margin-bottom: 16px;">
            <div style="margin-bottom: 4px;"><strong>Password</strong></div>
            <InputPassword @bind-Value="@newHost.Password" />
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 24px;">
            <Button OnClick="() => addModalVisible = false">Cancel</Button>
            <Button Type="@ButtonType.Primary" Loading="@addingHost" OnClick="AddHost">OK</Button>
        </div>
    </div>
</Modal>

@code {
    private List<Data.XcpHost> hosts = new();
    private bool loading = true;
    private bool addModalVisible;
    private bool addingHost;
    private NewHostModel newHost = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadHosts();
    }

    private async Task LoadHosts()
    {
        loading = true;
        hosts = await HostService.GetAllHostsAsync();
        loading = false;
    }

    private void ShowAddModal()
    {
        newHost = new NewHostModel();
        addModalVisible = true;
        StateHasChanged();
    }

    private async Task AddHost()
    {
        if (string.IsNullOrWhiteSpace(newHost.HostName) ||
            string.IsNullOrWhiteSpace(newHost.HostUrl) ||
            string.IsNullOrWhiteSpace(newHost.Username) ||
            string.IsNullOrWhiteSpace(newHost.Password))
        {
            await MessageService.Error("All fields are required.");
            return;
        }

        if (!newHost.HostUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase) &&
            !newHost.HostUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
        {
            await MessageService.Error("URL must start with https:// or http://");
            return;
        }

        if (!Uri.TryCreate(newHost.HostUrl, UriKind.Absolute, out _))
        {
            await MessageService.Error("URL is not valid. Example: https://192.168.1.167");
            return;
        }

        addingHost = true;
        StateHasChanged();

        try
        {
            await HostService.AddHostAsync(newHost.HostName, newHost.HostUrl, newHost.Username, newHost.Password);
            await MessageService.Success("Host added successfully");
            addModalVisible = false;
            await LoadHosts();
        }
        catch (Exception ex)
        {
            await MessageService.Error($"Failed to add host: {ex.Message}");
        }
        finally
        {
            addingHost = false;
            StateHasChanged();
        }
    }

    private async Task TestConnection(Data.XcpHost host)
    {
        try
        {
            var canConnect = await HostService.TestConnectionAsync(host.HostUrl, host.Username, host.PasswordHash);
            if (canConnect)
                await MessageService.Success("Connection successful!");
            else
                await MessageService.Error("Connection failed");
        }
        catch (Exception ex)
        {
            await MessageService.Error($"Test failed: {ex.Message}");
        }
    }

    private async Task DeleteHost(Data.XcpHost host)
    {
        try
        {
            await HostService.DeleteHostAsync(host.HostId);
            await MessageService.Success("Host deleted");
            await LoadHosts();
        }
        catch (Exception ex)
        {
            await MessageService.Error($"Delete failed: {ex.Message}");
        }
    }

    public class NewHostModel
    {
        public string HostName { get; set; } = "";
        public string HostUrl { get; set; } = "";
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
